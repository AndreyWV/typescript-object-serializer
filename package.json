{
    "name": "typescript-object-serializer",
    "version": "2.1.0-alpha.1",
    "description": "Powerful Scalable Typescript object serializer",
    "scripts": {
        "build": "tsc -p prod.tsconfig.json && npm run build:copy-files",
        "build:copy-files": "cp package.json dist && cp README.md dist && cp validators-package.json dist/validators/package.json",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "lint": "eslint src tests",
        "playground": "TS_NODE_PROJECT=\"playground/tsconfig.json\" ts-node playground/index.ts"
    },
    "keywords": [
        "typescript",
        "class",
        "object",
        "serialize",
        "api",
        "validator"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AndreyWV/typescript-object-serializer.git"
    },
    "bugs": {
        "url": "https://github.com/AndreyWV/typescript-object-serializer/issues"
    },
    "homepage": "https://github.com/AndreyWV/typescript-object-serializer",
    "author": "andrey.w.v@gmail.com",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/jest": "~30.0.0",
        "@types/node": "^25.6.1",
        "@typescript-eslint/eslint-plugin": "^8.59.2",
        "@typescript-eslint/parser": "^8.59.2",
        "eslint": "^10.3.0",
        "eslint-plugin-import-newlines": "^2.0.0",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "globals": "^17.6.0",
        "jest": "~30.3.0",
        "path-browserify": "~1.0.1",
        "reflect-metadata": "~0.2.2",
        "ts-jest": "~29.4.9",
        "ts-loader": "~9.5.7",
        "ts-node": "~10.9.2",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.59.2"
    },
    "peerDependencies": {
        "reflect-metadata": ">0.1.12 && <1.0.0"
    },
    "peerDependenciesMeta": {
        "reflect-metadata": {
            "optional": true
        }
    },
    "source": "src/index.ts",
    "main": "index.js",
    "module": "index.js",
    "types": "index.d.ts"
}
