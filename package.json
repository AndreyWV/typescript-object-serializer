    },
    "bugs": {
        "url": "https://github.com/AndreyWV/typescript-object-serializer/issues"
    },
    "homepage": "https://github.com/AndreyWV/typescript-object-serializer",
    "author": "andrey.w.v@gmail.com",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^9.28.0",
        "@types/jest": "~29.5.14",
        "@types/node": "^22.15.30",
        "@typescript-eslint/eslint-plugin": "^8.33.1",
        "@typescript-eslint/parser": "^8.33.1",
        "eslint": "^9.28.0",
        "globals": "^16.2.0",
        "jest": "~29.7.0",
        "path-browserify": "~1.0.1",
        "reflect-metadata": "~0.2.2",
        "ts-jest": "~29.3.4",
        "ts-loader": "~9.5.2",
