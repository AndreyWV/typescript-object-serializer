{
    "compileOnSave": false,
    "compilerOptions": {
        "baseUrl": ".",
        "declaration": true,
        "emitDecoratorMetadata": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "lib": [
            "ES2015",
            "ES2017",
            "ES2018",
            "ESNext",
            "dom"
        ],
        "module": "CommonJS",
        "moduleResolution": "node",
        "noImplicitAny": true,
        "outDir": "./dist",
        "sourceMap": true,
        "strict": true,
        "strictBindCallApply": true,
        "strictFunctionTypes": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": true,
        "target": "es2015",
        "types": [
            "reflect-metadata",
            "jest"
        ]
    },
    "exclude": [
        "node_modules"
    ],
    "include": [
        "src",
        "playground",
        "tests"
    ]
}
