{
    "compileOnSave": false,
    "compilerOptions": {
        "declaration": true,
        "emitDecoratorMetadata": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "isolatedModules": true,
        "lib": [
            "ES2015",
            "ES2017",
            "ES2018",
            "ESNext",
            "dom"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noImplicitAny": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "sourceMap": true,
        "strict": true,
        "strictBindCallApply": true,
        "strictFunctionTypes": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": true,
        "target": "es2015",
        "types": [
            "reflect-metadata",
            "vitest"
        ]
    },
    "exclude": [
        "node_modules"
    ],
    "include": [
        "./src",
        "./playground",
        "./tests",
        "./vitest.config.mts"
    ]
}
